generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  exercises        Exercise[]
  routines         Routine[]
  workouts         Workout[]
  supersetGroups   SupersetGroup[]

  @@map("profiles")
}

model Exercise {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  name            String
  description     String?
  muscleGroup     String?  @map("muscle_group")
  defaultRepRange String?  @map("default_rep_range")
  isGlobal        Boolean  @default(false) @map("is_global")
  createdAt       DateTime @default(now()) @map("created_at")

  user             Profile?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineExercises RoutineExercise[]
  workoutExercises WorkoutExercise[]

  @@index([userId])
  @@map("exercises")
}

model Routine {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user             Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises        RoutineExercise[]
  supersetGroups   SupersetGroup[]
  workouts         Workout[]

  @@index([userId])
  @@map("routines")
}

model SupersetGroup {
  id        String @id @default(uuid()) @db.Uuid
  routineId String @map("routine_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  label     String?

  routine  Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user     Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]

  @@index([routineId])
  @@map("superset_groups")
}

model RoutineExercise {
  id               String  @id @default(uuid()) @db.Uuid
  routineId        String  @map("routine_id") @db.Uuid
  exerciseId       String  @map("exercise_id") @db.Uuid
  order            Int
  sets             Int     @default(3)
  repsMin          Int     @map("reps_min")
  repsMax          Int     @map("reps_max")
  restSeconds      Int     @default(90) @map("rest_seconds")
  notes            String?
  isOptional       Boolean @default(false) @map("is_optional")
  loadProgression  Boolean @default(true) @map("load_progression")
  supersetGroupId  String? @map("superset_group_id") @db.Uuid
  supersetOrder    Int?    @map("superset_order")

  routine         Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise        Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  supersetGroup   SupersetGroup?   @relation(fields: [supersetGroupId], references: [id], onDelete: SetNull)
  workoutExercises WorkoutExercise[]

  @@unique([routineId, order])
  @@index([routineId])
  @@index([supersetGroupId])
  @@map("routine_exercises")
}

enum WorkoutStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Workout {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  routineId       String        @map("routine_id") @db.Uuid
  date            DateTime      @db.Date
  startedAt       DateTime      @default(now()) @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  durationSeconds Int?          @map("duration_seconds")
  status          WorkoutStatus @default(IN_PROGRESS)

  user      Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine   Routine           @relation(fields: [routineId], references: [id], onDelete: Restrict)
  exercises WorkoutExercise[]

  @@index([userId, date])
  @@index([routineId])
  @@map("workouts")
}

model WorkoutExercise {
  id                String  @id @default(uuid()) @db.Uuid
  workoutId         String  @map("workout_id") @db.Uuid
  exerciseId        String  @map("exercise_id") @db.Uuid
  routineExerciseId String? @map("routine_exercise_id") @db.Uuid
  order             Int
  skipped           Boolean @default(false)

  workout         Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise        Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  routineExercise RoutineExercise? @relation(fields: [routineExerciseId], references: [id], onDelete: SetNull)
  sets            WorkoutSet[]

  @@index([workoutId])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                String    @id @default(uuid()) @db.Uuid
  workoutExerciseId String    @map("workout_exercise_id") @db.Uuid
  setNumber         Int       @map("set_number")
  weight            Decimal   @db.Decimal(8, 2)
  reps              Int
  rir               Int?
  completedAt       DateTime  @default(now()) @map("completed_at")
  notes             String?

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, setNumber])
  @@index([workoutExerciseId])
  @@map("workout_sets")
}
